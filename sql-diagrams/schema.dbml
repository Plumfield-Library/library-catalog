Table patrons [headercolor: #175e7a] {
	id integer [ pk ]
	first_name text [ not null ]
	last_name text [ not null ]
	full_name text
	can_checkout integer [ not null, default: 1 ]
	can_place_holds integer [ not null, default: 1 ]
}

Table books [headercolor: #175e7a] {
	id integer [ pk ]
	title text [ not null ]
	authors text
}

Table series [headercolor: #175e7a] {
	id integer [ pk ]
	title text [ not null ]
}

Table holds [headercolor: #175e7a] {
	placed_at text [ not null, default: CURRENT_TIMESTAMP ]
	expires_at text [ not null, default: `datetime('now', '+14 days')` ]
	book_id integer [ not null ]
	patron_id integer [ not null ]
	id integer [ pk ]
}

Table checkouts [headercolor: #175e7a] {
	placed_at text [ not null, default: CURRENT_TIMESTAMP ]
	expires_at text [ not null, default: `datetime('now', '+45 days')` ]
	returned_at text
	id integer [ pk ]
	book_id integer [ not null ]
	patron_id integer [ not null ]
}

Table collections [headercolor: #175e7a] {
	id integer [ pk, increment, not null, unique ]
	name text(255) [ not null ]
}

Table books_collections [headercolor: #627a17] {
	book integer [ pk ]
	collection integer [ pk ]
}

Table tags [headercolor: #175e7a] {
	id integer [ pk, increment, not null ]
	name text(255)
}

Table tags_books [headercolor: #172e7a] {
	tag integer [ pk ]
	book integer [ pk ]
}

Table book_series [headercolor: #41177a] {
	book integer [ pk, not null ]
	series integer [ pk, not null ]
	series_number integer [ note: 'Series number on join record incase book has a different series number in each series' ]
}

Table copies [headercolor: #175e7a] {
	id integer [ pk, increment, not null ]
	branch text(225) [ not null, default: 'main' ]
	barcode text(255) [ not null, unique ]
	format text(255) [ not null, default: 'hardcover' ]
	book integer [ not null ]
	call_number text(255)
	status text(255) [ not null, default: 'present' ]
	last_inventoried text(65535)
}

Ref books_on_hold {
	holds.book_id > books.id [ delete: cascade, update: no action ]
}

Ref patron_holds {
	holds.patron_id > patrons.id [ delete: cascade, update: no action ]
}

Ref books_checked_out {
	checkouts.book_id > books.id [ delete: cascade, update: no action ]
}

Ref patron_checkouts {
	checkouts.patron_id > patrons.id [ delete: cascade, update: no action ]
}

Ref book_collections {
	books_collections.book > books.id [ delete: cascade, update: no action ]
}

Ref books_in_collection {
	books_collections.collection > collections.id [ delete: cascade, update: no action ]
}

Ref book_tags {
	tags_books.book > books.id [ delete: no action, update: no action ]
}

Ref books_tagged_with_tag {
	tags_books.tag > tags.id [ delete: cascade, update: no action ]
}

Ref book_series {
	book_series.book > books.id [ delete: cascade, update: no action ]
}

Ref books_in_series {
	book_series.series > series.id [ delete: cascade, update: no action ]
}

Ref book_copy {
	copies.book > books.id [ delete: cascade, update: no action ]
}